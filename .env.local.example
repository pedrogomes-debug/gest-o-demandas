# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do app (Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Usada só pelo script de verificação (npm run smoke). Nunca vai para o browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — montar demanda por linguagem natural em /demandas
# Pegue a chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional (padrão: gemini-2.0-flash). Ex.: gemini-1.5-pro, gemini-2.5-pro
# GEMINI_MODEL=gemini-2.0-flash
