# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do app (Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Usada só pelo script de verificação (npm run smoke). Nunca vai para o browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude (Anthropic) — montar demanda por linguagem natural em /demandas
# Pegue a chave em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Opcional (padrão: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
